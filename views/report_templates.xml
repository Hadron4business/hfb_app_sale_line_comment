<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_line_comment" inherit_id="sale.report_saleorder_document">
        <xpath expr="//td[@name='td_product_name']" position="inside">
            <div t-if="line.line_comment" class="text-muted fst-italic" t-field="line.line_comment"/>
        </xpath>
    </template>

    <template id="report_invoice_document_line_comment" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <div t-if="line.line_comment" class="text-muted fst-italic" t-field="line.line_comment"/>
        </xpath>
    </template>

</odoo>
