<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_line_comment" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.line.comment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="before">
                <field name="sale_line_comment" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
