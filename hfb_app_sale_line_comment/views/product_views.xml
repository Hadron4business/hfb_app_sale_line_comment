<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_line_comment" model="ir.ui.view">
        <field name="name">product.template.form.inherit.line.comment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="upsell" position="after">
                <group name="line_comment" string="Website Cart">
                    <field name="sale_line_comment"/>
                    <field name="sale_line_comment_label" invisible="not sale_line_comment"
                           placeholder="e.g. Engraving text"/>
                </group>
            </group>
        </field>
    </record>

    <record id="product_category_form_view_line_comment" model="ir.ui.view">
        <field name="name">product.category.form.inherit.line.comment</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <group name="first" position="after">
                <group name="line_comment" string="Website Cart">
                    <field name="sale_line_comment"/>
                    <field name="sale_line_comment_label" invisible="not sale_line_comment"
                           placeholder="e.g. Engraving text"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
